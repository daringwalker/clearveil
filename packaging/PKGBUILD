# Maintainer: daringwalker
pkgname=clearveil
pkgver=0.2.0beta.1
pkgrel=1
pkgdesc='Fast, friendly image viewer for Linux (云开见月明)'
arch=(x86_64 aarch64)
url='https://github.com/daringwalker/clearveil'
license=(GPL-3.0-or-later)
options=(!debug)
depends=(qt6-base qt6-svg exiv2 libcolord libvips tesseract tesseract-data-eng)
makedepends=(cmake ninja qt6-tools)
optdepends=(
  'kimageformats: support additional image formats'
  'qt6-imageformats: support additional Qt image formats'
  'tesseract-data-chi_sim: recognize Simplified Chinese text in images'
  'tesseract-data-chi_tra: recognize Traditional Chinese text in images'
)
_release_version=0.2.0-beta.1
_source_dir="${pkgname}-${_release_version}-Source"
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${_release_version}/${_source_dir}.tar.gz")
sha256sums=('SKIP') # Updated to the release archive checksum before publishing.

build() {
  cmake -S "$_source_dir" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
